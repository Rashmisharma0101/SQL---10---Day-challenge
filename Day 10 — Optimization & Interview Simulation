Simulate an end-to-end question:
 - Find top 3 customers by revenue in each month who increased spending vs the previous month.”
 - with cte1 as (select customer_id, month(order_amount) as mn, sum(order_amount) as revenue from orders
group by customer_id, mn),
cte2 as (select customer_id, mn, revenue, lag(revenue,1) over (partition by mn order by revenue desc) as prev_rev
from cte1),
cte3 as (Select customer_id, mn, revenue, row_number() over (partition by mn order by revenue desc) as rn from cte3
where revenue > prev_rev and prev_rev is not null),
select customer_id, mn, revenue from cte3 where rn <= 3 order by mn, revenue desc



